{
  "name": "openclaw-workshop-web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint",
    "test": "playwright test --project=smoke",
    "test:e2e": "node -e \"if(!process.env.E2E_BASE_URL){console.error('Set E2E_BASE_URL=https://workshop-<namespace>.<cluster-apps-domain>');process.exit(1)}\" && playwright test --project=e2e",
    "test:isolation": "node -e \"if(!process.env.E2E_BASE_URL||!process.env.E2E_PEER_NAMESPACE_PREFIX){console.error('Set E2E_BASE_URL, E2E_ACCESS_TOKEN and E2E_PEER_NAMESPACE_PREFIX (e.g. user30)');process.exit(1)}\" && playwright test --project=isolation",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "11.12.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "node-pty": "^1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "~9.39.0",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "protobufjs": false,
    "unrs-resolver": false
  }
}
