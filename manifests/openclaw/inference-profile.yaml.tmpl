# OpenShell 0.1.x provider profile for the workshop's OpenAI-compatible inference endpoint
# (replaces the 0.0.x `inference.local` privacy router / `openshell inference set`).
#
# Rendered by configure_inference (scripts/lib/common.sh) with
#   envsubst '${INFERENCE_HOST} ${INFERENCE_PORT}'
# where host and port come from NEMOCLAW_INFERENCE_BASE_URL:
#   https://api.example.com/v1                         -> api.example.com      443
#   http://nemotron.maas.svc.cluster.local:8080/v1     -> nemotron.maas.svc... 8080
#   http://gateway.maas.svc.cluster.local/v1           -> gateway.maas.svc...  80
# then imported into the gateway (`openshell provider profile import -f`), and a provider
# of this type is created with the key (`openshell provider create --type maas-openai`).
#
# How it works: a sandbox created with `--provider <name>` sees OPENAI_API_KEY as an
# opaque placeholder (openshell:resolve:env:...). The supervisor proxy swaps it for the
# real key ONLY on requests to the endpoint below, from the binaries below, and the
# attached provider adds that endpoint to the sandbox's effective network policy (so the
# sandbox policy files need no inference entry). OpenClaw's baseUrl is the REAL base URL.
#
# TLS note: credential substitution needs L7 inspection, i.e. plain http, or https with a
# certificate the supervisor trusts (public CAs). For an in-cluster endpoint signed by the
# OpenShift service CA, point NEMOCLAW_INFERENCE_BASE_URL at its plain-http service port.
id: maas-openai
display_name: OpenAI-compatible inference (workshop)
description: OpenAI-compatible endpoint configured from NEMOCLAW_INFERENCE_BASE_URL
category: inference
inference_capable: true
credentials:
  - name: api_key
    description: API key for the inference endpoint
    env_vars: [OPENAI_API_KEY]
    required: true
    auth_style: bearer
    header_name: authorization
discovery:
  credentials: [api_key]
endpoints:
  - host: ${INFERENCE_HOST}
    port: ${INFERENCE_PORT}
    protocol: rest
    access: read-write
    enforcement: enforce
# Node.js (OpenClaw runs on it) and curl, at both image layouts: the openclaw-sandbox image
# ships nodesource node in /usr/bin and an `n`-installed node in /usr/local/bin.
binaries: [/usr/local/bin/node, /usr/bin/node, /usr/local/bin/curl, /usr/bin/curl]
