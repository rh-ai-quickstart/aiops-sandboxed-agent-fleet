# Copy to .env and fill in. Sourced by scripts/deploy.sh (single instance) and
# scripts/lab.sh (multi-attendee lab). NEVER commit the filled-in .env (see .gitignore).

# --- Cluster ---
# Auto-detected from the cluster's ingresses.config if left blank.
CLUSTER_APPS_DOMAIN=""

# --- Inference: an OpenAI-compatible endpoint (remote API or in-cluster MaaS) ---
# The base URL may be https://host/v1 or an in-cluster http://svc.ns.svc.cluster.local:8080/v1;
# its host/port become the endpoint of the OpenShell provider profile `maas-openai`
# (manifests/openclaw/inference-profile.yaml.tmpl). For an in-cluster endpoint served with the
# OpenShift service CA, use its plain-http port (the sandbox proxy must inspect the request
# to inject the key). Leave blank to deploy the agents without a model.
NEMOCLAW_INFERENCE_BASE_URL=""            # e.g. https://integrate.api.nvidia.com/v1
NEMOCLAW_MODEL=""                         # model id served by the endpoint
NEMOCLAW_API_KEY=""                       # key for the endpoint (stored in a Secret, never in Helm values)
NEMOCLAW_INFERENCE_PROVIDER="default"     # OpenShell provider name the sandboxes attach (--provider)
NEMOCLAW_INFERENCE_API="openai-completions"  # OpenClaw provider API flavour

# Password of the OpenClaw Control UI (single-instance mode; lab mode generates one per
# attendee). The first browser also needs one-time device pairing from the lab shell.
OPENCLAW_GATEWAY_PASSWORD="openclaw"
# Grafana admin password (single-instance default "openclaw"; lab.sh generates one if unset).
MONITORING_GRAFANA_PASSWORD=""

# --- ghcr.io pull auth (OPTIONAL but recommended) ---
# Anonymous ghcr.io pulls of the multi-GB sandbox image get throttled. With a token the
# scripts create Secret `ghcr-pull` and reference it from the sandbox pods and the prepull.
GHCR_USER=""                              # GitHub username (blank -> oauth2)
GHCR_TOKEN=""                             # GitHub PAT with read:packages

# --- Images (blank = chart defaults) ---
# Workshop image: the chart default (quay.io/mouachan/nemoclaw-workshop:v0.3.0) is built from this repository.
# Set it only when you rebuild the image (web/Dockerfile): probes on /healthz, env contract.
WORKSHOP_IMAGE=""                         # e.g. quay.io/<org>/nemoclaw-workshop:<tag>
# OpenClaw sandbox image (community base + newer Node/OpenClaw, images/openclaw-sandbox).
OPENCLAW_SANDBOX_IMAGE=""                 # default ghcr.io/ansjindal/openclaw-sandbox:2026.8.2

# --- Single-instance mode (scripts/deploy.sh) ---
OPENSHELL_NAMESPACE="openshell"           # gateway, registry, workshop, sandboxes
DEMO_NAMESPACE="demo"                     # demo app (Incident Lab)
MONITORING_NAMESPACE="monitoring"         # Grafana + event-exporter (shared in lab mode)
# SKIP_OBSERVABILITY=true                 # skip scripts/15-observability.sh (already deployed)
# DEPLOY_DEMO_APP=false                   # do not apply manifests/demo-app
# DEPLOY_FLEET=false                      # do not pre-create the 5 fleet agents
# PROVISION_AGENT=true                    # also pre-create the `shifty` agent (scripts/45-openclaw.sh)
# UWM_ENABLE_ALERTMANAGER=true            # also enable the user-workload Alertmanager

# --- agent-sandbox (cluster-scoped prerequisite, scripts/lib/common.sh ensure_agent_sandbox) ---
# AGENT_SANDBOX_VERSION="v1.0.3"
# AGENT_SANDBOX_MIGRATE=1                 # replace an old v1alpha1-only install (deletes ALL Sandboxes)

# --- Lab mode (scripts/lab.sh) ---
# LAB_USER_PREFIX="user"                  # attendees user01..userNN
# LAB_NODE_SELECTOR="node-role.kubernetes.io/lab="   # "none" = off; ignored when no node has the label
# LAB_INFERENCE_KEYS_FILE=""              # CSV user,key[,model[,base_url]] for per-attendee keys
# LAB_INFERENCE_UPDATE=1                  # re-push key/endpoint to existing gateways (re-issues the
#                                         # sandboxes' placeholders: restart running OpenClaw gateways)
# LAB_SKIP_OBSERVABILITY=1                # observability stack already deployed
# LAB_DEMO_APP=false                      # do not deploy the demo app per attendee
# LAB_HELM_TIMEOUT="15m"
# LAB_PREPULL_TIMEOUT="1800"              # seconds to wait for the prepull DaemonSet

# --- Self-hosted inference: OpenShift AI Models-as-a-Service + Nemotron (scripts/maas.sh) ---
# After `scripts/maas.sh up`, `scripts/maas.sh env` prints the two values below and
# `scripts/maas.sh keys <N>` writes one key per attendee to .lab/maas-keys.csv:
#   NEMOCLAW_INFERENCE_BASE_URL="https://maas.<apps-domain>/maas-models/nemotron-3-nano/v1"
#   NEMOCLAW_MODEL="nemotron-3-nano"
#   LAB_INFERENCE_KEYS_FILE="$PWD/.lab/maas-keys.csv"
# MAAS_GPU_INSTANCE_TYPE="g6e.2xlarge"     # 1x NVIDIA L40S 48GB per GPU node (model: 32.7 GB FP8)
# MAAS_GPU_REPLICAS="1"                    # GPU nodes = model replicas; 2 recommended for 30 attendees
# MAAS_GPU_SOURCE_MACHINESET=""            # worker MachineSet to clone (default: the first one)
# MAAS_GPU_DISK_GB="200"
# MAAS_TOKENS_PER_MINUTE="5000000"         # MaaSSubscription token rate limit
# MAAS_KEY_OWNER=""                        # OpenShift user that mints the keys (default: oc whoami)
